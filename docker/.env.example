# Copiar a ../.env (cp docker/.env.example ../.env) y rellenar.
# chmod 600 .env despues de rellenar: contiene contrasenas.

# --- Telegram (obligatorio) ---
TELEGRAM_BOT_TOKEN=
CHAT_ID=
THREAD_ID=
STARTUP_MESSAGE=

# --- Entorno ---
TZ=Europe/Madrid
DRY_RUN=

# --- PostgreSQL (obligatorio) ---
# DATABASE_URL se construye a partir de estas, no se define a mano.
POSTGRES_USER=tgbot
POSTGRES_PASSWORD=
POSTGRES_DB=tgbot
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Panel de administracion web ---
WEB_HOST=0.0.0.0
WEB_PORT=8080
ADMIN_USER=admin
ADMIN_PASSWORD=
ADMIN_ROLE=admin

# --- Localidad por defecto para festivos de Espana (codigo INE, 5 digitos) ---
# Solo se usa en el primer arranque; despues se gestiona desde /admin/location.
SPAIN_MUNICIPIO=03031
